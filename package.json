{
  "name": "pdt-aserdargun-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/write-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "asset:build": "/Applications/Blender.app/Contents/MacOS/Blender -b --python scripts/build_asset.py",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "validate": "npm test && npm run build && npm run verify:artifact && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "@aserdargun/lab-core": "file:vendor/aserdargun-lab-core-0.1.0-e5cb8baabeebc68c.tgz",
    "@aserdargun/lab-ui": "file:vendor/aserdargun-lab-ui-0.1.0-ad3719af737d3971.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
